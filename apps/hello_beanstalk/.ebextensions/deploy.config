# Beanstalk applies .ebextensions/*.config from the bundle root on each deploy.
# A value set directly in the console or API overrides this file for that option.
option_settings:
  aws:elasticbeanstalk:command:
    # In place on the existing instance(s): fastest, brief downtime.
    # Immutable (new instances in a temporary ASG) was tried; it took ~10 minutes.
    DeploymentPolicy: AllAtOnce
